{
  "name": "opencode-idea-inbox",
  "version": "0.4.0",
  "description": "opencode plugin: capture ideas to a sidebar backlog mid-conversation, then dispatch them from the command palette into the current session or background sessions",
  "license": "MIT",
  "author": "apilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apilot/opencode-idea-inbox.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "backlog",
    "ideas",
    "tui",
    "sidebar",
    "productivity"
  ],
  "type": "module",
  "main": "./src/server/index.ts",
  "exports": {
    ".": "./src/server/index.ts",
    "./tui": "./src/tui/index.tsx"
  },
  "engines": {
    "opencode": ">=2.0.20"
  },
  "files": [
    "src",
    "commands",
    "tsconfig.json",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.20"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.20",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
