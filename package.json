{
  "name": "opencode-idea-inbox",
  "version": "0.3.5",
  "description": "opencode plugin: capture ideas to a sidebar backlog mid-conversation, then dispatch them from the command palette into the current session or background sessions",
  "license": "MIT",
  "author": "apilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apilot/opencode-idea-inbox.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "backlog",
    "ideas",
    "tui",
    "sidebar",
    "productivity"
  ],
  "type": "module",
  "main": "./src/server/index.ts",
  "exports": {
    ".": "./src/server/index.ts",
    "./server": "./src/server/index.ts",
    "./tui": "./src/tui/index.tsx"
  },
  "engines": {
    "opencode": ">=1.18.31"
  },
  "files": [
    "src",
    "commands",
    "tsconfig.json",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@opencode-ai/sdk": "^1.18.31",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
